# Copy to backend/.env for local backend/Prisma commands. Use local values only.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://sicip_dev:change-me@localhost:5432/sicip_dev?schema=public"
JWT_SECRET="replace-with-at-least-32-character-development-secret"
FRONTEND_URL="http://localhost:3000"
REQUEST_BODY_LIMIT=1mb
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OPENAI_API_KEY="replace-with-development-openai-key-or-leave-unset-for-mocked-tests"
OPENAI_MODEL="gpt-4o-mini"
MATCHING_EMBEDDING_MODEL="text-embedding-3-small"
MATCHING_RANKING_MODEL="gpt-4o-mini"
